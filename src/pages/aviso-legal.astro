---
import Layout from '../layouts/Layout.astro';
import { EMAIL, NIF, DIRECCION_ES } from '../lib/contacto';

// El dominio sale de `site` en astro.config.mjs, su fuente única, igual que
// canonical y sitemap. Aquí no se declara: se lee.
if (!Astro.site) {
  throw new Error('astro.config.mjs debe definir `site`: de ahí sale el dominio publicado en esta página.');
}
const siteOrigin = Astro.site.origin;
---
<Layout
  title="Aviso Legal"
  description="Datos identificativos de Alonso & Campos Advisors S.L. conforme al artículo 10 de la LSSI-CE."
>

  <section class="page-header">
    <div class="container">
      <p class="eyebrow" style="color:var(--gold)">Legal</p>
      <h1 class="display-title" style="color:var(--white);">Aviso <em style="color:var(--gold);">Legal</em></h1>
      <p style="color:rgba(255,255,255,0.65);font-size:1rem;max-width:560px;margin-top:1rem;line-height:1.75;">
        Conforme al artículo 10 de la Ley 34/2002, de 11 de julio, de servicios de la sociedad
        de la información y de comercio electrónico (LSSI-CE).
        Última actualización: 22 de agosto de 2026.
      </p>
    </div>
  </section>

  <section class="section" style="background:var(--white);">
    <div class="container">
      <div class="policy-body">

        <div class="policy-block">
          <h2>Datos identificativos</h2>
          <p>
            Los datos identificativos del titular de este sitio web son los siguientes.
          </p>
          <table class="policy-table">
            <tbody>
              <tr><th>Denominación social</th><td>Alonso &amp; Campos Advisors S.L.</td></tr>
              <tr><th>NIF</th><td>{NIF}</td></tr>
              <tr><th>Domicilio social</th><td>{DIRECCION_ES}</td></tr>
              <tr><th>Correo electrónico</th><td><a href={`mailto:${EMAIL}`}>{EMAIL}</a></td></tr>
              <tr><th>Sitio web</th><td>{siteOrigin}</td></tr>
              {/* PENDIENTE: datos registrales — tomo, folio, hoja y Registro Mercantil de León.
                  Sin ellos la fila no se renderiza. */}
            </tbody>
          </table>
        </div>

        <div class="policy-block">
          <h2>Protección de datos</h2>
          <p>
            El tratamiento de datos personales se describe en la
            <a href="/privacidad/">Política de Privacidad</a>.
          </p>
        </div>

        <div class="policy-back">
          <a href="/contacto/" class="btn btn-outline">← Volver al contacto</a>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
  .page-header {
    background: var(--night);
    padding: 5rem 0 4rem;
    background-image: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(61,90,128,0.3) 0%, transparent 70%);
  }

  .policy-body {
    max-width: 780px;
  }

  .policy-block {
    margin-bottom: 3rem;
  }

  .policy-block h2 {
    font-family: var(--ff-display);
    font-size: 1.25rem;
    color: var(--night);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--gold);
    display: inline-block;
  }

  .policy-block p {
    color: var(--text);
    line-height: 1.8;
    margin-bottom: 0.75rem;
  }

  .policy-block a {
    color: var(--slate);
    text-decoration: underline;
  }

  .policy-block a:hover {
    color: var(--night);
  }

  .policy-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  .policy-table th,
  .policy-table td {
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
    line-height: 1.6;
  }

  .policy-table th {
    background: var(--ivory);
    color: var(--night);
    font-weight: 600;
    width: 38%;
  }

  .policy-table td {
    color: var(--text);
  }

  .policy-table td a {
    color: var(--slate);
    text-decoration: underline;
  }

  .policy-back {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
