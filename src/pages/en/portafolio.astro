---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Portfolio" description="Service lines of Alonso & Campos Advisors: AI, digital, data and R&D&I." lang="en">

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container">
      <p class="eyebrow" style="color:var(--gold)">What we do</p>
      <h1 class="display-title" style="color:var(--white);">Portfolio of<br><em style="color:var(--gold);">services</em></h1>
      <p style="color:rgba(255,255,255,0.65);font-size:1.05rem;max-width:560px;margin-top:1rem;line-height:1.75;">
        Four complementary lines of work that allow us to accompany our clients from strategy through to implementation.
      </p>
      <nav class="page-nav">
        <a href="#ai">I. AI Governance</a>
        <a href="#digital">II. Digital platforms</a>
        <a href="#datos">III. Data & observatories</a>
        <a href="#idi">IV. R&D&I</a>
        <a href="#sipam">GIAHS</a>
      </nav>
    </div>
  </section>

  <!-- ─── I. AI ─── -->
  <section class="section service-section" id="ai">
    <div class="container">
      <div class="service-header">
        <div class="service-roman">I</div>
        <div>
          <p class="eyebrow">Service line I</p>
          <h2 class="display-title">Technology advisory<br>& <em>AI governance</em></h2>
          <div class="divider"></div>
          <p class="lead">
            We help organisations and public administrations incorporate artificial intelligence
            with robust governance, ethics and security criteria.
          </p>
        </div>
      </div>
      <div class="service-items">
        <div class="service-item">
          <h3>AI systems advisory & assessment</h3>
          <p>Analysis of algorithmic ethics, bias, security and data protection in AI systems already deployed or under consideration.</p>
        </div>
        <div class="service-item">
          <h3>Algorithmic governance frameworks</h3>
          <p>Design of internal policies, committees, roles and procedures for the responsible use of AI within the organisation.</p>
        </div>
        <div class="service-item">
          <h3>Ethics, risk assessment & compliance</h3>
          <p>Alignment with the European AI Act and applicable sector standards. Compliance audits and action plans.</p>
        </div>
        <div class="service-item">
          <h3>AI adoption advisory</h3>
          <p>Identification of use cases, proof of concept and tailored guides for non-technical teams that want to use AI safely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── II. DIGITAL ─── -->
  <section class="section service-section alt" id="digital">
    <div class="container">
      <div class="service-header reverse">
        <div class="service-roman">II</div>
        <div>
          <p class="eyebrow">Service line II</p>
          <h2 class="display-title">Digital platforms<br>& <em>solutions</em></h2>
          <div class="divider"></div>
          <p class="lead">
            We apply systemic design to the strategic planning and definition of
            digital transformation. From idea to functional product.
          </p>
        </div>
      </div>
      <div class="service-items">
        <div class="service-item">
          <h3>Software design & development advisory</h3>
          <p>Strategic evaluation of digital application and platform adoption using systemic design methodologies.</p>
        </div>
        <div class="service-item">
          <h3>Prototypes, proof of concept & MVPs</h3>
          <p>Rapid idea validation before committing to product investment. We reduce investment risk through early iteration.</p>
        </div>
        <div class="service-item">
          <h3>Applied AI model analysis</h3>
          <p>Studies and recommendations for adopting machine learning, generative AI, agents and algorithmic systems in specific contexts.</p>
        </div>
        <div class="service-item">
          <h3>Monitoring, evaluation & change management</h3>
          <p>Ongoing support after implementation: scenario evaluation, improvement suggestions and organisational change management.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── III. DATA ─── -->
  <section class="section service-section" id="datos">
    <div class="container">
      <div class="service-header">
        <div class="service-roman">III</div>
        <div>
          <p class="eyebrow">Service line III</p>
          <h2 class="display-title">Data, observatories<br>& <em>specialised knowledge</em></h2>
          <div class="divider"></div>
          <p class="lead">
            We turn dispersed information into useful assets for data-driven decision-making
            through structured data, indicators and visualisation tools.
          </p>
        </div>
      </div>
      <div class="service-items">
        <div class="service-item">
          <h3>Database structures & repositories</h3>
          <p>Design and recommendation of robust, reusable and scalable database and document repository structures.</p>
        </div>
        <div class="service-item">
          <h3>Sectoral digital observatories</h3>
          <p>Indicator monitoring for companies, cooperatives, foundations and other institutions. Dashboards and periodic reports.</p>
        </div>
        <div class="service-item">
          <h3>Specialised information solutions</h3>
          <p>Recommendation of information systems tailored to specific scenarios: territorial, sectoral or thematic.</p>
        </div>
        <div class="service-item">
          <h3>Advanced knowledge management</h3>
          <p>Identification of documentation systems and specialised digital libraries for the preservation and dissemination of institutional knowledge.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── IV. R&D&I ─── -->
  <section class="section service-section alt" id="idi">
    <div class="container">
      <div class="service-header reverse">
        <div class="service-roman">IV</div>
        <div>
          <p class="eyebrow">Service line IV</p>
          <h2 class="display-title">R&D&I<br><em>Projects</em></h2>
          <div class="divider"></div>
          <p class="lead">
            We design and manage competitive projects in national and international funding calls,
            from identification through to closure.
          </p>
        </div>
      </div>
      <div class="idi-phases">
        <div class="idi-phase">
          <div class="idi-num">01</div>
          <div>
            <h3>Identify</h3>
            <p>Mapping of relevant calls and analysis of fit with each client's objectives and identity.</p>
          </div>
        </div>
        <div class="idi-phase">
          <div class="idi-num">02</div>
          <div>
            <h3>Formulate</h3>
            <p>Complete technical recommendation: project narrative, detailed budget and work plan.</p>
          </div>
        </div>
        <div class="idi-phase">
          <div class="idi-num">03</div>
          <div>
            <h3>Articulate</h3>
            <p>Coordination of national and international partners, consortium management and agreement negotiation.</p>
          </div>
        </div>
        <div class="idi-phase">
          <div class="idi-num">04</div>
          <div>
            <h3>Monitor</h3>
            <p>Execution monitoring, results analysis, funder reports and improvement recommendations.</p>
          </div>
        </div>
      </div>
      <div class="idi-funds">
        <p class="eyebrow" style="margin-top:3rem;">Typical funding programmes</p>
        <div class="funds-grid">
          <span>Horizon Europe</span>
          <span>CDTI / PERTE</span>
          <span>Red.es</span>
          <span>ERDF / ESF+</span>
          <span>Recovery Plan</span>
          <span>Private foundations</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── GIAHS ─── -->
  <section class="section sipam-section" id="sipam">
    <div class="container">
      <div class="sipam-grid">
        <div>
          <p class="eyebrow" style="color:var(--gold);">Social commitment</p>
          <h2 style="font-family:var(--ff-display);font-size:clamp(1.75rem,3vw,2.75rem);color:var(--white);line-height:1.2;margin-bottom:1rem;">
            GIAHS &<br><em style="color:var(--gold);">rural territories</em>
          </h2>
          <div class="divider" style="background:var(--gold);"></div>
          <p style="color:rgba(255,255,255,0.72);line-height:1.8;margin-bottom:2rem;">
            Our firm explicitly includes in its corporate purpose the development of technological
            projects applied to rural territories, mountain areas and the Globally Important
            Agricultural Heritage Systems (GIAHS) of the FAO.
          </p>
          <p style="color:rgba(255,255,255,0.72);line-height:1.8;margin-bottom:2rem;">
            GIAHS are agricultural systems of global importance that combine biodiversity,
            landscapes, local knowledge and culture. Our firm provides the technological
            tools to make these systems visible, managed and transmitted to future generations.
          </p>
          <a href="/en/contacto/" class="btn btn-gold">Contact us for GIAHS projects →</a>
        </div>
        <div class="sipam-cards">
          <div class="sipam-card">
            <div class="sipam-icon">⬡</div>
            <h3>GIAHS platforms & observatories</h3>
            <p>Monitoring, visualisation and indicator systems for managing world agricultural heritage.</p>
          </div>
          <div class="sipam-card">
            <div class="sipam-icon">⬡</div>
            <h3>Heritage data repositories</h3>
            <p>Reusable and scalable data structures for preserving territorial knowledge.</p>
          </div>
          <div class="sipam-card">
            <div class="sipam-icon">⬡</div>
            <h3>Territorial knowledge management tools</h3>
            <p>Advanced solutions to document, organise and disseminate the knowledge of rural and mountain territories.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--ivory);padding:5rem 0;text-align:center;">
    <div class="container">
      <p class="eyebrow">Does it fit your project?</p>
      <h2 class="display-title" style="margin-bottom:1rem;">Let's talk about your challenge</h2>
      <p class="lead" style="margin:0 auto 2rem;">No commitment. We assess the fit before any formal proposal.</p>
      <a href="/en/contacto/" class="btn btn-primary" style="font-size:1rem;padding:0.875rem 2.25rem;">Start a conversation →</a>
    </div>
  </section>

</Layout>

<style>
  .page-header {
    background: var(--night);
    padding: 5rem 0 4rem;
    background-image: radial-gradient(ellipse 50% 80% at 85% 40%, rgba(61,90,128,0.35) 0%, transparent 70%);
  }
  .page-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; }
  .page-nav a {
    font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(255,255,255,0.5); padding: 0.35rem 1rem;
    border: 1px solid rgba(255,255,255,0.15); border-radius: 2px; transition: all 0.2s;
  }
  .page-nav a:hover { color: var(--gold); border-color: var(--gold); }

  .service-section { background: var(--white); }
  .service-section.alt { background: var(--ivory); }
  .service-header { display: grid; grid-template-columns: 120px 1fr; gap: 3rem; align-items: start; margin-bottom: 3.5rem; }
  .service-roman { font-family: var(--ff-display); font-size: 6rem; font-weight: 700; color: var(--border); line-height: 1; padding-top: 0.5rem; }

  .service-items { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; border: 1px solid var(--border); }
  .service-item { padding: 2rem 2.25rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .service-item:nth-child(2n) { border-right: none; }
  .service-item:nth-last-child(-n+2) { border-bottom: none; }
  .service-item h3 { font-family: var(--ff-display); font-size: 1.05rem; color: var(--night); margin-bottom: 0.6rem; line-height: 1.3; }
  .service-item p { color: var(--muted); font-size: 0.9rem; line-height: 1.7; }

  .idi-phases { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--border); }
  .idi-phase { padding: 2.5rem 2rem; border-right: 1px solid var(--border); }
  .idi-phase:last-child { border-right: none; }
  .idi-num { font-family: var(--ff-display); font-size: 2.5rem; font-weight: 700; color: var(--gold-text); line-height: 1; margin-bottom: 1rem; }
  .idi-phase h3 { font-size: 1rem; font-weight: 600; color: var(--night); margin-bottom: 0.5rem; }
  .idi-phase p { color: var(--muted); font-size: 0.875rem; line-height: 1.65; }

  .funds-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.75rem; }
  .funds-grid span { background: var(--ivory); border: 1px solid var(--border); padding: 0.35rem 0.9rem; font-size: 0.8rem; font-weight: 500; color: var(--night); border-radius: 2px; }

  .sipam-section { background: var(--night); background-image: linear-gradient(160deg, #111520 0%, #1b2d45 100%); }
  .sipam-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }
  .sipam-cards { display: flex; flex-direction: column; gap: 1.5rem; }
  .sipam-card { padding: 1.75rem; border: 1px solid rgba(200,169,110,0.2); border-left: 3px solid var(--gold); }
  .sipam-icon { color: var(--gold); font-size: 1.25rem; margin-bottom: 0.75rem; }
  .sipam-card h3 { color: var(--white); font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
  .sipam-card p { color: rgba(255,255,255,0.6); font-size: 0.875rem; line-height: 1.65; }

  @media (max-width: 900px) {
    .service-header { grid-template-columns: 1fr; }
    .service-roman { font-size: 4rem; }
    .service-items { grid-template-columns: 1fr; }
    .service-item { border-right: none; }
    .service-item:nth-last-child(-n+2) { border-bottom: 1px solid var(--border); }
    .service-item:last-child { border-bottom: none; }
    .idi-phases { grid-template-columns: repeat(2, 1fr); }
    .idi-phase:nth-child(2) { border-right: none; }
    .idi-phase:nth-child(3) { border-right: 1px solid var(--border); }
    .sipam-grid { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 560px) {
    .idi-phases { grid-template-columns: 1fr; }
    .idi-phase { border-right: none; border-bottom: 1px solid var(--border); }
    .idi-phase:last-child { border-bottom: none; }
  }
</style>
