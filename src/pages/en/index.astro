---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Home" description="Alonso & Campos Advisors — Strategic, technological and innovation advisory. León, Spain." lang="en">

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-diagonal"></div>
    <div class="container hero-content">
      <p class="eyebrow" style="color:var(--gold)">León · Spain · World</p>
      <h1 class="hero-title">
        Where decisions<br>
        <em>converge</em><br>
        to transform.
      </h1>
      <p class="hero-lead">
        Strategic, technological and innovation advisory for organisations
        that want to act with clarity in a complex environment.
      </p>
      <div class="hero-actions">
        <a href="/en/portafolio/" class="btn btn-gold">Our portfolio</a>
        <a href="/en/nosotros/" class="btn" style="background:transparent;color:var(--white);border:1.5px solid rgba(255,255,255,0.35);">Meet the team</a>
      </div>
    </div>
  </section>

  <!-- ─── APPROACH ─── -->
  <section class="section" style="background:var(--white);">
    <div class="container">
      <div class="two-col">
        <div>
          <p class="eyebrow">Our approach</p>
          <h2 class="display-title">Strategy that <em>can be executed</em>.</h2>
          <div class="divider"></div>
          <p class="lead">
            We work at the crossroads of the companies, organisations and institutions
            that underpin economic and sustainable development, with a clear commitment
            to putting technology at their service.
          </p>
        </div>
        <div class="principles">
          <div class="principle">
            <div class="principle-icon">01</div>
            <div>
              <h3>Advisory + technology</h3>
              <p>We do not separate strategic advice from its digital implementation. Every recommendation is designed to be executed, measured and sustained.</p>
            </div>
          </div>
          <div class="principle">
            <div class="principle-icon">02</div>
            <div>
              <h3>Territorial perspective</h3>
              <p>Solutions calibrated to urban and rural, agricultural and mountain realities: real rhythms, scales and capacities, not rigid theoretical templates.</p>
            </div>
          </div>
          <div class="principle">
            <div class="principle-icon">03</div>
            <div>
              <h3>Dual readability</h3>
              <p>We speak the language of executive boards and governing councils and, at the same time, that of institutions and investors, in Spain and internationally.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── METHOD: THE 4 CONFLUENCES ─── */}
  <section class="section" style="background:var(--white);border-top:1px solid var(--border);">
    <div class="container">
      <div style="text-align:center;margin-bottom:3.5rem;">
        <p class="eyebrow">Our method</p>
        <h2 class="display-title" style="margin:0 auto;">The 4 Confluences</h2>
        <p class="lead" style="max-width:640px;margin:1.25rem auto 0;">
          Our own diagnostic and support framework. Four questions that intersect in every project.
        </p>
      </div>
      <div class="confluencias">
        <div class="confluencia">
          <div class="confluencia-num">01</div>
          <h3>Actors</h3>
          <p class="confluencia-q">Who decides and sustains</p>
          <p>Governing councils, partners, management and public bodies. We map real power and governance, not the org chart.</p>
        </div>
        <div class="confluencia">
          <div class="confluencia-num">02</div>
          <h3>Resources</h3>
          <p class="confluencia-q">What it is executed with</p>
          <p>Public and private funding, internal capabilities and available data. What makes each decision viable.</p>
        </div>
        <div class="confluencia">
          <div class="confluencia-num">03</div>
          <h3>Territory</h3>
          <p class="confluencia-q">Where and for whom</p>
          <p>Urban or rural, corporate or cooperative, and mountain realities: rhythms, scales and culture. Innovation arrives at the place; it is not imposed.</p>
        </div>
        <div class="confluencia">
          <div class="confluencia-num">04</div>
          <h3>Technology</h3>
          <p class="confluencia-q">What amplifies it</p>
          <p>AI, platforms and data: the lever, not the goal. It amplifies the organisation's judgement; it does not replace it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SERVICE LINES ─── -->
  <section class="section" style="background:var(--ivory);">
    <div class="container">
      <div style="text-align:center;margin-bottom:3.5rem;">
        <p class="eyebrow">What we do</p>
        <h2 class="display-title" style="margin:0 auto;">Four complementary<br><em>lines of work</em></h2>
      </div>
      <div class="services-grid">
        <a href="/en/portafolio/#ai" class="service-card">
          <div class="service-num">I</div>
          <h3>Technology consulting & AI governance</h3>
          <p>Incorporating artificial intelligence with robust governance, ethics and security criteria. Alignment with the European AI Act.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/en/portafolio/#digital" class="service-card">
          <div class="service-num">II</div>
          <h3>Digital platforms & solutions</h3>
          <p>Design and specification of AI-enabled platforms, prototypes and proofs of concept, and user-guided evolution.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/en/portafolio/#datos" class="service-card">
          <div class="service-num">III</div>
          <h3>Data, observatories & territorial knowledge</h3>
          <p>We turn dispersed information into useful assets for decision-making: databases, sectoral observatories and geographic information systems.</p>
          <span class="service-link">Learn more →</span>
        </a>
        <a href="/en/portafolio/#cambio" class="service-card">
          <div class="service-num">IV</div>
          <h3>Transformation & change management</h3>
          <p>Organisational redesign, governance and change support, including leadership coaching.</p>
          <span class="service-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── WHO WE WORK WITH ─── -->
  <section class="section" style="background:var(--night);">
    <div class="container">
      <div style="text-align:center;margin-bottom:3rem;">
        <p class="eyebrow" style="color:var(--gold)">Who we work with</p>
        <h2 class="display-title" style="color:var(--white);">Organisations that underpin<br><em style="color:var(--gold);">sustainable development</em></h2>
      </div>
      <div class="audience-grid">
        <div class="audience-item">
          <div class="audience-icon">◈</div>
          <p>Agricultural cooperatives and social financial institutions</p>
        </div>
        <div class="audience-item">
          <div class="audience-icon">◈</div>
          <p>Medium and large companies (250+ employees)</p>
        </div>
        <div class="audience-item">
          <div class="audience-icon">◈</div>
          <p>Public administrations and universities</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── TEAM ─── -->
  <section class="section" style="background:var(--white);">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:3rem;flex-wrap:wrap;gap:1rem;">
        <div>
          <p class="eyebrow">Founding team</p>
          <h2 class="display-title">Three partners,<br><em>complementary expertise</em></h2>
        </div>
        <a href="/en/nosotros/" class="btn btn-outline">View full profiles</a>
      </div>
      <div class="team-grid">
        <div class="team-card">
          <div class="team-avatar">AA</div>
          <h3>Antonio Alonso Sánchez</h3>
          <p class="team-role">Founding Partner</p>
          <p>Organisational development, innovation and strategic planning.</p>
        </div>
        <div class="team-card">
          <div class="team-avatar">EW</div>
          <h3>Erica Wurzba Campos</h3>
          <p class="team-role">Founding Partner</p>
          <p>Systemic design, leadership development and governance.</p>
        </div>
        <div class="team-card">
          <div class="team-avatar">JE</div>
          <h3>J. Eduardo Campos</h3>
          <p class="team-role">Founding Partner</p>
          <p>Digital transformation, systemic design and artificial intelligence.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ─── -->
  <section class="cta-banner">
    <div class="container" style="text-align:center;">
      <p class="eyebrow" style="color:var(--gold);">Shall we talk?</p>
      <h2 style="font-family:var(--ff-display);font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--white);margin-bottom:1rem;">
        Every project begins with a conversation.
      </h2>
      <p style="color:rgba(255,255,255,0.65);margin-bottom:2rem;max-width:500px;margin-left:auto;margin-right:auto;">
        Tell us about your challenge. No commitment — we explore together whether there's a fit.
      </p>
      <a href="/en/contacto/" class="btn btn-gold" style="font-size:1rem;padding:0.875rem 2.25rem;">Get in touch →</a>
    </div>
  </section>

</Layout>

<style>
  .hero {
    position: relative;
    background: var(--night);
    padding: 6rem 0 7rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 60% at 70% 50%, rgba(61,90,128,0.35) 0%, transparent 70%);
  }
  .hero-diagonal {
    position: absolute;
    top: 0; right: -10%;
    width: 45%; height: 100%;
    background: linear-gradient(135deg, transparent 48%, rgba(200,169,110,0.08) 48%);
    border-left: 1px solid rgba(200,169,110,0.2);
    transform: skewX(-5deg);
  }
  .hero-content { position: relative; z-index: 1; max-width: 680px; }
  .hero-title {
    font-family: var(--ff-display);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .hero-title em { font-style: italic; color: var(--gold); }
  .hero-lead {
    font-size: 1.15rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: 2.5rem;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .principles { display: flex; flex-direction: column; gap: 1.75rem; }
  .principle {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .principle:last-child { border-bottom: none; padding-bottom: 0; }
  .principle-icon {
    font-family: var(--ff-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold-text);
    min-width: 36px;
    margin-top: 0.1rem;
  }
  .principle h3 { font-size: 1rem; font-weight: 600; color: var(--night); margin-bottom: 0.4rem; }
  .principle p { color: var(--muted); font-size: 0.925rem; }

  .confluencias {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
    background: var(--border);
    border: 1.5px solid var(--border);
  }
  .confluencia {
    background: var(--ivory);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .confluencia-num {
    font-family: var(--ff-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gold-text);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .confluencia h3 {
    font-family: var(--ff-display);
    font-size: 1.35rem;
    color: var(--night);
    line-height: 1.2;
  }
  .confluencia-q {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gold-text);
    margin-bottom: 0.25rem;
  }
  .confluencia p:last-child {
    font-size: 0.95rem;
    color: var(--text-muted, #555);
    line-height: 1.6;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5px;
    background: var(--border);
    border: 1.5px solid var(--border);
  }
  .service-card {
    background: var(--ivory);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: background 0.2s;
    cursor: pointer;
  }
  .service-card:hover { background: var(--white); }
  .service-num {
    font-family: var(--ff-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--gold-text);
    line-height: 1;
  }
  .service-card h3 { font-family: var(--ff-display); font-size: 1.2rem; color: var(--night); line-height: 1.3; }
  .service-card p { color: var(--muted); font-size: 0.9rem; flex: 1; }
  .service-link { font-size: 0.8rem; font-weight: 600; color: var(--gold-text); letter-spacing: 0.04em; }

  .audience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .audience-item {
    text-align: center;
    padding: 2rem 1rem;
    border: 1px solid rgba(200,169,110,0.2);
    border-radius: 2px;
  }
  .audience-icon { font-size: 1.5rem; color: var(--gold); margin-bottom: 1rem; }
  .audience-item p { color: rgba(255,255,255,0.7); font-size: 0.9rem; line-height: 1.5; }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .team-card {
    padding: 2.5rem 2rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--gold);
    border-radius: 0 0 2px 2px;
  }
  .team-avatar {
    width: 60px; height: 60px;
    background: var(--night);
    color: var(--gold);
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: 1.1rem;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    margin-bottom: 1.25rem;
  }
  .team-card h3 { font-family: var(--ff-display); font-size: 1.1rem; margin-bottom: 0.25rem; color: var(--night); }
  .team-role { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-text); margin-bottom: 0.75rem; }
  .team-card p { color: var(--muted); font-size: 0.9rem; }

  .cta-banner {
    background: var(--slate);
    padding: 5rem 0;
    background-image: linear-gradient(135deg, var(--night) 0%, var(--slate) 100%);
  }

  @media (max-width: 900px) {
    .two-col { grid-template-columns: 1fr; gap: 3rem; }
    .services-grid { grid-template-columns: 1fr; }
    .confluencias { grid-template-columns: repeat(2, 1fr); }
    .audience-grid { grid-template-columns: repeat(2, 1fr); }
    .team-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .audience-grid { grid-template-columns: 1fr; }
    .confluencias { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
  }
</style>
